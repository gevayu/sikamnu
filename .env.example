# שרת
PORT=8787
HOST=127.0.0.1                  # רק המחשב הזה. 0.0.0.0 פותח לכל הרשת, ועמודי השיחות בלי טוקן
PUBLIC_URL=http://localhost:8787
AUTH_TOKEN=dev-token            # התוסף שולח את זה ב-?token=. להחליף לפני שמישהו אחר מתחבר
DATA_DIR=data                   # אחסון מקומי כשאין Supabase

# ספקי STT. המפתחות בשרת בלבד, אף פעם לא בתוסף
DEEPGRAM_API_KEY=
ASSEMBLYAI_API_KEY=
AAI_SPEECH_MODEL=               # למשל universal-3.5-pro. לאמת את שם הפרמטר ב-bake-off
STT_LIVE_PROVIDER=              # deepgram | assemblyai. ריק = לפי שפה (he→deepgram, multi→assemblyai)
STT_BATCH_PROVIDER=             # deepgram | assemblyai | whisper. ריק = לפי שפה

# תמלול מקומי עם whisper.cpp, batch בלבד. האודיו לא יוצא מהמחשב. ריק = כבוי
# מודל עברי: https://huggingface.co/ivrit-ai/whisper-large-v3-turbo-ggml
WHISPER_MODEL=                  # נתיב מלא לקובץ ggml, למשל /Users/me/whisper-models/ggml-ivrit-turbo.bin
WHISPER_CLI=                    # ריק = whisper-cli מה-PATH

# סיכום
ANTHROPIC_API_KEY=
SUMMARY_MODEL=claude-sonnet-5

# Supabase (אופציונלי. ריק = קבצים מקומיים ב-DATA_DIR)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
