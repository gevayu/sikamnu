{
  "manifest_version": 3,
  "name": "Si-kam-nu",
  "version": "0.1.6",
  "description": "תמלול וסיכום שיחות Google Meet ו-Zoom בעברית, בלי בוט בשיחה.",
  "permissions": ["tabCapture", "offscreen", "sidePanel", "storage", "notifications", "activeTab"],
  "host_permissions": ["https://meet.google.com/*", "https://*.zoom.us/*", "*://localhost/*", "*://127.0.0.1/*"],
  "background": { "service_worker": "dist/background.js", "type": "module" },
  "content_scripts": [
    { "matches": ["https://meet.google.com/*"], "js": ["dist/content-meet.js"], "run_at": "document_idle" },
    { "matches": ["https://*.zoom.us/wc/*", "https://app.zoom.us/wc/*"], "js": ["dist/content-zoom.js"], "run_at": "document_idle" }
  ],
  "side_panel": { "default_path": "sidepanel.html" },
  "icons": { "128": "icons/idle.png" },
  "action": { "default_title": "Si-kam-nu", "default_icon": "icons/idle.png" },
  "options_page": "options.html",
  "commands": {
    "mark-moment": { "suggested_key": { "default": "Alt+Shift+M" }, "description": "סמן רגע" }
  }
}
